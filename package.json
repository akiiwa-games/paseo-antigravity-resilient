{
  "name": "antigravity-resilient-provider",
  "private": true,
  "version": "0.2.0",
  "description": "Paseo Antigravity provider with durable conversation replay and bounded CLI recovery.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.paseo",
    "docs/UPSTREAM.md",
    "icon.svg",
    "index.server.ts",
    "server/",
    "shared/",
    "docs/INSTALL.md"
  ],
  "scripts": {
    "typecheck": "node ./scripts/typecheck.mjs",
    "verify:install": "node ./scripts/verify-install.mjs",
    "test": "node --experimental-strip-types --import ./test/register-sdk.mjs --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.2",
    "@getpaseo/plugin": "0.11.2",
    "@getpaseo/protocol": "0.11.2",
    "typescript": "5.9.3",
    "ws": "8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiiwa-games/paseo-antigravity-resilient.git"
  }
}
