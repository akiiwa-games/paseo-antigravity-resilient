{
  "name": "antigravity-resilient-provider",
  "private": true,
  "version": "0.3.0",
  "description": "Paseo Antigravity ACP provider with automatic context compaction, bounded transient recovery, and CLI usage quota reporting.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.paseo",
    "docs/UPSTREAM.md",
    "docs/INSTALL.md",
    "icon.svg",
    "index.server.ts",
    "server/"
  ],
  "scripts": {
    "typecheck": "node ./scripts/typecheck.mjs",
    "verify:install": "node ./scripts/verify-install.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.17.4",
    "@getpaseo/plugin": "0.17.4",
    "@getpaseo/protocol": "0.17.4",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "ws": "8.22.1",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiiwa-games/paseo-antigravity-resilient.git"
  }
}
